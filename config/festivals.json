{
 "_about": "Observance rules. A rule names a lunar month in amanta reckoning, a pakṣa, a tithi, the part of the day in which the tithi must hold (vyāpti), and how to choose between two days. Dates are computed, never stored; anchors are published dates the test suite checks against.",
 "vyapti_windows": {
  "udaya": "the instant of sunrise",
  "purvahna": "sunrise to midday",
  "madhyahna": "third fifth of daylight",
  "aparahna": "fourth fifth of daylight",
  "pradosha": "first fifth of the night",
  "nishitha": "eighth muhurta of the night",
  "moonrise": "the instant of moonrise",
  "sunset": "the instant of sunset",
  "first-third-of-day": "sunrise to a third of daylight"
 },
 "prefer_rules": {
  "udaya": "the day whose sunrise falls inside the tithi; a kṣaya tithi falls back to the day holding most of it",
  "max-overlap": "the day whose window holds the tithi longest; a tie goes to the first day"
 },
